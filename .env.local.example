# --- Público: va al navegador y no es secreto ---------------------------------------------
# Identifican el proyecto, no autorizan nada. Quien protege los datos son las reglas de
# Firestore y la verificación de rol del servidor.
# Salen de la consola de Firebase, registrando una app WEB (no sirve el appId de Android).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=masterdriver-506a0.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=masterdriver-506a0
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Secreto: NUNCA con prefijo NEXT_PUBLIC ------------------------------------------------
# Cuenta de servicio, en una sola línea de JSON. Consola de Firebase, Configuración del
# proyecto, Cuentas de servicio, Generar nueva clave privada.
#
# Con esta clave se puede leer y escribir el proyecto entero sin pasar por ninguna regla.
# Si se filtra, hay que revocarla en la consola de Google Cloud el mismo día.
FIREBASE_SERVICE_ACCOUNT=
